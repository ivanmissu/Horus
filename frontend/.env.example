# Local Next.js development. Production compose uses the repository-root .env.example.
DATABASE_URL=mysql://horus:change_me_horus@127.0.0.1:3306/horus
HORUS_DEMO_MODE=false
HORUS_INIT_OWNER_USERNAME=admin
HORUS_INIT_OWNER_NAME=团队负责人
APP_URL=http://localhost:3000
HORUS_NEW_WINDOW_DAYS=7
NEXT_PUBLIC_NEW_WINDOW_DAYS=7
HORUS_DB_CONNECTION_LIMIT=10

# Container entrypoint switches (ignored by `npm run dev`).
# Set these when the schema is created outside the container with deploy/mysql/*.sql.
#HORUS_DB_PUSH=false
#HORUS_DB_INIT=false
#HORUS_DB_WAIT_TIMEOUT=90
#HORUS_DB_STEP_TIMEOUT=180
