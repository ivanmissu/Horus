# K8s: see docs/kubernetes-deployment.md; mount an app-only .env via Secret.
# Container default: /app/.env; set HORUS_ENV_FILE for a custom path.
# Existing environment variables take precedence over the mounted file.
# Copy to .env in the repository root before `docker compose up -d --build`.
# Use letters, numbers, and underscores in passwords so the URL and healthcheck stay unambiguous.

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=horus
MYSQL_USER=horus
MYSQL_PASSWORD=change_me_horus

# The app container overrides this host to `mysql`. Kept here for local `npm run dev`.
DATABASE_URL=mysql://horus:change_me_horus@127.0.0.1:3306/horus

# Production default: force login and do not seed demo teams.
HORUS_DEMO_MODE=false

HORUS_INIT_OWNER_USERNAME=admin
HORUS_INIT_OWNER_NAME=团队负责人

# Public origin used in DingTalk digest links. No trailing path required.
APP_URL=http://localhost:3000

# Rolling window for “本周新建”. Default 7, allowed range 1–90.
# HORUS_NEW_WINDOW_DAYS is read at runtime and sent to the UI.
# NEXT_PUBLIC_NEW_WINDOW_DAYS is baked into the client bundle at image build.
# Keep them equal. A runtime-only change takes effect after `docker compose up -d --build`
# if you also want the client fallback to match; the server value alone updates the UI.
HORUS_NEW_WINDOW_DAYS=7
NEXT_PUBLIC_NEW_WINDOW_DAYS=7

HORUS_PORT=3000
HORUS_DB_CONNECTION_LIMIT=10
TZ=Asia/Shanghai
